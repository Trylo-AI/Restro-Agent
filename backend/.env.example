# Restro backend — copy to backend/.env (git-ignored) and fill in. Run scripts/new-dev-secrets.ps1 for the dev-only values.
# Paste your values after each ">>> PASTE" comment. Everything else is already set.

APP_ENV=local
LOG_LEVEL=info

# ---------------------------------------------------------------- Supabase
# Project Settings -> API: Project URL, e.g. https://abcdefghijklmnop.supabase.co
# >>> PASTE your value right after the = on the next line
SUPABASE_URL=
# Project Settings -> API Keys -> Secret key (starts with sb_secret_). Backend + seed script only.
# >>> PASTE your value right after the = on the next line
SUPABASE_SECRET_KEY=
# JWT: new signing keys. Verified with the public JWKS at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json, so no JWT secret is needed.
SUPABASE_JWT_AUDIENCE=authenticated

# Connect (top bar) -> Connection string -> "Transaction pooler" (port 6543). Used by api + worker.
# Looks like: postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# If the password has @ : / # ? % characters, URL-encode them (e.g. @ -> %40).
# >>> PASTE your value right after the = on the next line
DATABASE_URL=
# Same panel -> "Session pooler" (port 5432). Used only for migrations and the seed script.
# >>> PASTE your value right after the = on the next line
DATABASE_URL_SESSION=

# ---------------------------------------------------------------- LLM
# developer_api (Gemini API key, now) | vertex (GCP, later) | stub (tests)
LLM_BACKEND=developer_api
# Google AI Studio -> Get API key. Synthetic data only on the free tier.
# >>> PASTE your value right after the = on the next line
GEMINI_API_KEY=
# Used only when LLM_BACKEND=vertex (Application Default Credentials):
GCP_PROJECT=
GCP_LOCATION=global
# Model ids are config, verified when S9 starts. Per-cafe settings.model overrides the primary.
LLM_MODEL_PRIMARY=gemini-2.5-flash-lite
LLM_MODEL_FALLBACK=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=6
# off | cheap | handoff
LLM_KILL_SWITCH=off
LLM_DAILY_SPEND_LIMIT_USD=2

# ---------------------------------------------------------------- WhatsApp
# simulator (now) | meta (real Cloud API, later)
WA_TRANSPORT=simulator
# Generated for local dev: the simulator signs webhooks with this, exactly like Meta would.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------- Tasks and internal auth
# local (in-process shim, now) | cloud_tasks (later)
TASKS_BACKEND=local
# local (in-process shim, now) | pubsub (later)
SIGNAL_BACKEND=local
WORKER_URL=http://localhost:8001
API_URL=http://localhost:8000
# dev_token (now) | oidc (Cloud Tasks, later)
INTERNAL_AUTH=dev_token
INTERNAL_DEV_TOKEN=

# ---------------------------------------------------------------- Secrets
# env (this file, now) | gcp (Secret Manager, later). cafes.token_ref = "env:WA_TOKEN_DEMO"
SECRETS_BACKEND=env
WA_TOKEN_DEMO=simulator-not-a-real-token

# ---------------------------------------------------------------- Local dev tools
SIMULATOR_ENABLED=true
SIMULATOR_TOKEN=
DEV_TRACES=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Password for the seeded staff logins (shift@restro.test, manager@restro.test, owner@restro.test)
SEED_STAFF_PASSWORD=
