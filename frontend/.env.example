# Restro Console — copy to frontend/.env.local (git-ignored). Only public values.

# Project Settings -> API: Project URL
# >>> PASTE your value right after the = on the next line
VITE_SUPABASE_URL=
# Project Settings -> API Keys -> Publishable key (starts with sb_publishable_). Never the secret key.
# >>> PASTE your value right after the = on the next line
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_API_URL=http://localhost:8000
# Shows the "sign in as" role picker. Off in any real build.
VITE_DEMO=true
